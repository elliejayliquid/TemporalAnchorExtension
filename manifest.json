{
  "manifest_version": 3,
  "name": "Temporal Anchor",
  "version": "1.2",
  "description": "Adds timestamps to messages automatically.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Toggle Timestamp"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://chatgpt.com/*",
        "*://chat.deepseek.com/*",
        "*://claude.ai/*",
        "*://gemini.google.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "icons": {
    "128": "icon.png"
  }
}